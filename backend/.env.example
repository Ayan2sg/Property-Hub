# Server
PORT=3001
NODE_ENV=development

# PostgreSQL (local: use docker-compose.yml, production: Render/Railway/Neon URL)
DATABASE_URL=postgresql://prophaven:prophaven@localhost:5432/prophaven

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:8080

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Admin account (used when running npm run seed)
ADMIN_EMAIL=admin@prophaven.com
ADMIN_PASSWORD=admin123

# Razorpay (optional — required for card/UPI checkout via Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
